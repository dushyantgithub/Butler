# Copy to .env. Use official user OAuth tokens; never passwords or Safari cookies.
# Values are read by the server only and are never sent to the local model.
BUTLER_X_ACCESS_TOKEN=''
BUTLER_X_CLIENT_ID=''
BUTLER_X_REFRESH_TOKEN=''
BUTLER_X_EXPIRES_AT=''
BUTLER_X_SCOPE=''
BUTLER_X_CONNECTED_AT=''
BUTLER_LINKEDIN_ACCESS_TOKEN=''
BUTLER_LINKEDIN_CLIENT_ID=''
BUTLER_LINKEDIN_CLIENT_SECRET=''
BUTLER_LINKEDIN_EXPIRES_AT=''
BUTLER_LINKEDIN_CONNECTED_AT=''
BUTLER_LINKEDIN_AUTHOR=''
BUTLER_LINKEDIN_VERSION='202603'
# Optional cloud AI engine keys. Used only when Office settings > AI engine is set to cloud.
BUTLER_ANTHROPIC_API_KEY=''
BUTLER_OPENAI_API_KEY=''
